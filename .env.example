# Supabase browser read configuration. VITE_* variables are public in Vite/Netlify.
VITE_SUPABASE_URL=https://ealbeiqstgqsdjmobxly.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-readonly-anon-key

# Netlify Edge Function dashboard access credentials.
# Configure these in Netlify Site settings -> Environment variables.
# Never commit real passwords or session secrets.
VELZ_DASHBOARD_USERNAME=miguel
VELZ_DASHBOARD_PASSWORD=replace-with-generated-strong-password
# Optional: lets you rotate the password without invalidating existing sessions.
VELZ_DASHBOARD_SESSION_SECRET=replace-with-generated-strong-session-secret
